<div class="field">
  <%= f.label :name %><br />
  <%= f.text_field :name %>
</div>

<div class="field">
  <%= f.label :postal_code %><br />
  <%= f.text_field :postal_code %>
</div>

<div class="field">
  <%= f.label :address %><br />
  <%= f.text_field :address %>
</div>

<div class="field">
  <%= f.label :self_introduction %><br />
  <%= f.text_area :self_introduction %>
</div>

<div class="field">
  <%= f.label :avatar %><br />
  <% if f.object.avatar.attached? %>
    <p><%= user_avatar_tag(f.object) %></p>
    <p><%= f.object.avatar.filename %>（<%= number_to_human_size f.object.avatar.byte_size %>）</p>
  <% end %>
  <p><%= f.file_field :avatar, accept: '.jpg,.jpeg,.png,.gif' %></p>
</div>
