<p style="color: green"><%= notice %></p>

<div>
  <% if I18n.locale == :ja %>
    <%= link_to "Switch language to English", url_for(locale: :en) %>
  <% else %>
    <%= link_to "言語を日本語に変更", url_for(locale: :ja) %>
  <% end %>
</div>

<h1><%= t ".html_title" %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t(".link_show"), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t(".new_book"), new_book_path %>
</nav>
